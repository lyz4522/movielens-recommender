# shell 脚本用 LF，否则 Linux 容器里执行会报错
* text=auto

*.sh text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.whl binary
*.png binary
*.jpg binary
*.pdf binary
*.tgz binary
*.zip binary
*.parquet binary
